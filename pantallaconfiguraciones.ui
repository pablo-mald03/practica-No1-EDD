             <property name="styleSheet">
              <string notr="true">QCheckBox#checkBoxFlip::indicator {
    width: 147px;
    height: 50px;
    border-radius: 25px;
}


QCheckBox#checkBoxFlip::indicator:unchecked {
    border: 2px solid #777;
    background: qradialgradient(
        cx:0.18, cy:0.5, radius:0.22,
        fx:0.18, fy:0.5,
        stop:0.9 #ffffff, stop:0.95 rgba(255, 255, 255, 0)
    ), #444444; 
}


QCheckBox#checkBoxFlip::indicator:checked {
    border: 2px solid #3ebf53;
    background: qradialgradient(
        cx:0.82, cy:0.5, radius:0.22,
        fx:0.82, fy:0.5,
        stop:0.9 #ffffff, stop:0.95 rgba(255, 255, 255, 0)
    ), #4cd964; 
}</string>
