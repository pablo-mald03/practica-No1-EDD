               <property name="styleSheet">
                <string notr="true">QCheckBox#checkRobo {
    color: black;
    font-size: 24px;
	font-weight: bold;
    spacing: 10px;           
}


QCheckBox#checkRobo::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #555555;
    border-radius: 4px;       
    background-color: #2D2D2D;
}


QCheckBox#checkRobo::indicator:hover {
    border: 2px solid #3498db;
    background-color: #3D3D3D;
}


QCheckBox#checkRobo::indicator:checked {
    background-color: #3498db; 
    border: 2px solid #3498db;

}

QCheckBox#checkRobo:disabled {
    color: black;
	font-weight: bold;
}
QCheckBox#checkRobo::indicator:disabled {
    border: 2px solid #333333;
    background-color: #222222;
}</string>
               </property>
