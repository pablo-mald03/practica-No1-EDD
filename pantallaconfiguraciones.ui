       <property name="styleSheet">
        <string notr="true">QPushButton#btnRetorno {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, 
                        stop:0 rgb(186, 156, 104), 
                        stop:1 rgba(255, 255, 255, 40));
    
    border: 3px solid rgb(130, 68, 5);
    border-radius: 20px;
    
    color: black;
    font-family: &quot;Arial Black&quot;, Gadget, sans-serif;
    font-size: 18px;
    font-weight: bold;
    text-transform: uppercase;
    
    padding: 10px 25px;
}

QPushButton#btnRetorno:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, 
                        stop:0 rgb(255, 72, 72), 
                        stop:1 rgba(142, 68, 173, 255));
    border-color: #f1c40f;
}


QPushButton#btnRetorno:pressed {
    background-color: #2c3e50;
    padding-top: 12px;
    padding-left: 27px;
}
</string>
